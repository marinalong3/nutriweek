# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe (cartão de crédito)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_FAMILY_PRICE_ID=price_xxxxxxxxxxxxxxxx

# Mercado Pago (PIX)
MP_ACCESS_TOKEN=your_mercadopago_access_token

# Resend (emails transacionais)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@nutriweek.com.br

# Z-API (WhatsApp - plano Família)
ZAPI_INSTANCE=your_zapi_instance
ZAPI_TOKEN=your_zapi_token

# App
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_super_secret_jwt_key_here
PORT=3000
NODE_ENV=development
